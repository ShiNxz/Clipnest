# ─────────────────────────────────────────────────────────────────────────────
# Clipnest — API
# Copy to `.env` and fill in. Everything here has a working default except the
# R2 block, so the app boots and you can log in before storage exists.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────

# Where the site lives. Used for the "/" redirect, and in production it becomes
# the cookie domain (as `.example.com`) so the API can set a cookie the site
# sends back. No trailing slash.
WEBSITE_URL = "http://localhost:3000"

API_PORT = 5600

# Signs the session cookie. Changing it logs everyone out immediately.
# Generate one with:  bun -e 'console.log(crypto.randomUUID().replaceAll("-",""))'
SECRET = "generate-something-long-and-random"

# Domain the session cookie is scoped to, in production only. Defaults to the
# host in WEBSITE_URL, which is correct when the API is a CHILD of the site
# (api.clips.example.com + clips.example.com).
# Set it explicitly when they're SIBLINGS — a host can only set cookies for
# itself or a parent, so clips-api.example.com cannot set a cookie for
# .clips.example.com and login will silently 401. Use the shared parent:
# COOKIE_DOMAIN = "example.com"


# ── First admin ──────────────────────────────────────────────────────────────
# Created on boot ONLY if no user with this name exists. It never overwrites a
# password that was changed later, so it's safe to leave set.
# If ADMIN_PASSWORD is omitted, one is generated and printed to the log once.

ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "change-me"


# ── Database ─────────────────────────────────────────────────────────────────

# Set this in production and the app connects to that Postgres.
# Leave it unset (or commented out) and it falls back to PGlite — the real
# Postgres engine as WASM, persisting to disk. Same schema, same migrations,
# nothing to install. Migrations run automatically on boot either way.
# DATABASE_URL = "postgres://user:pass@localhost:5432/clipnest"

# Where PGlite keeps its data, relative to apps/backend. Ignored when
# DATABASE_URL is set. Delete the folder to reset the database.
# PGLITE_DIR = "./.data/postgres"


# ── Cloudflare R2 ────────────────────────────────────────────────────────────
# The only genuinely required block — without it the site still runs and you can
# browse, but uploads fail with a message saying exactly what's missing.
#
# 1. Create a bucket and an R2 API token with Object Read & Write.
# 2. Expose the bucket publicly (r2.dev subdomain or a custom domain).
# 3. Add a CORS rule to the bucket allowing PUT from WEBSITE_URL — without it
#    the browser's direct upload is blocked. Exact JSON is in the readme.

R2_ACCOUNT_ID = ""
R2_ACCESS_KEY_ID = ""
R2_SECRET_ACCESS_KEY = ""
R2_BUCKET_NAME = "clipnest"

# Public hostname the bucket is served on — hostname only, no https:// and no
# trailing slash. This is what post URLs are built from.
R2_PUBLIC_URL = "r2.example.com"


# ── Optional ─────────────────────────────────────────────────────────────────

# Title and version shown on the Swagger page at /docs.
# NAME = "Clipnest API"
# VERSION = "1.0.0"

# What the site is called before anyone sets a name under /admin → Site. After
# that the database is the source of truth and this is ignored. Keep it the same
# as WEBSITE_NAME in apps/frontend/.env.
# WEBSITE_NAME = "Clipnest"

# Enables logDebug() output.
DEBUG_MODE = "false"

# NODE_ENV is set by `bun start` and doesn't belong here. In production it
# switches the cookie to Secure + the parent domain, and starts the cron tasks.
