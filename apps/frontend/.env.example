# ─────────────────────────────────────────────────────────────────────────────
# Clipnest — site
# Copy to `.env` and fill in.
# ─────────────────────────────────────────────────────────────────────────────

# Where the Elysia API lives — must match API_PORT in apps/backend/.env.
#
# This is INLINED AT BUILD TIME (via `env` in next.config.js), not read at
# runtime: a production build has to be made with the production value, and
# changing it afterwards means rebuilding, not just restarting.
API = "http://localhost:5600"

# Fallback name for the site, used only until an admin sets one under
# /admin → Site, and if the API can't be reached. That setting is the real one:
# it's stored in the database, so renaming the site doesn't need a redeploy.
WEBSITE_NAME = "Clipnest"

# Optional — the site's own public address, no trailing slash.
#
# Used by shared posts (/p/<id>) for their canonical URL and their og: tags,
# which have to be absolute for a link preview to work. Leave it unset and each
# request's own Host header is used instead, which is right in almost every
# setup; set it when the site sits behind something that rewrites the host, or
# to pin one canonical address when several point at the same site.
#
# Also INLINED AT BUILD TIME, like API above.
# WEBSITE_URL = "https://clips.example.com"
