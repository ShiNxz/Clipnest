{
	"name": "clipnest",
	"version": "1.0.0",
	"description": "Elysia Backend + Next.js — a private clips & memes feed for friends",
	"packageManager": "bun@1.1.12",
	"private": true,
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"dev": "concurrently \"bun frontend:dev\" \"bun backend:dev\"",
		"build": "concurrently \"bun backend:build\" \"bun frontend:build\"",
		"start": "concurrently \"bun backend:start\" \"bun frontend:start\"",
		"typecheck": "bunx --bun tsc",
		"lint": "biome lint .",
		"lint:fix": "biome lint --apply .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"frontend:dev": "cd apps/frontend && bun run dev",
		"frontend:build": "cd apps/frontend && bun run build",
		"frontend:start": "cd apps/frontend && bun run start",
		"backend:dev": "cd apps/backend && bun --bun run dev",
		"backend:build": "cd apps/backend && bun --bun run build",
		"backend:start": "cd apps/backend && bun --bun run start",
		"db:push": "cd apps/backend && bun run db:push",
		"db:generate": "cd apps/backend && bun run db:generate",
		"seed": "cd apps/backend && bun run seed",
		"studio": "cd apps/backend && drizzle-kit studio"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@elysiajs/eden": "1.1.3",
		"@types/bun": "^1.1.12",
		"concurrently": "^9.0.1",
		"elysia": "1.1.24"
	},
	"engines": {
		"npm": "Please use Bun",
		"yarn": "Please use Bun",
		"pnpm": "Please use Bun",
		"bun": ">=1.1.12",
		"node": ">=20"
	},
	"trustedDependencies": ["@biomejs/biome", "@electric-sql/pglite"]
}
