{
	"compilerOptions": {
		"target": "esnext",
		"module": "ESNext",
		"lib": ["ESNext", "DOM"],
		"composite": false,
		"declaration": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"moduleResolution": "node",
		"skipLibCheck": true,
		"strict": true
	},
	"include": ["."],
	"exclude": ["dist", "build", "node_modules"]
}
